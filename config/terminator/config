    background_color = "#2a373e"
    foreground_color = "#f5f5f5"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 100000
    title_hide_sizetext = True
    title_transmit_bg_color = "#455a64"
    title_inactive_fg_color = "#bbbbbb"
    title_inactive_bg_color = "#2a373e"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
